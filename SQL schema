-- ============================================================
-- FreshCount V2 — Database Schema + Seed Data
--
-- Core tables: categories, suppliers, stock_items, supplier_items,
--              stock_movements
-- Optional future tables: users, stocktake_sessions
--
-- Key change from V1 schema:
--   • supplier_id removed from stock_items
--   • New supplier_items join table — one item can have multiple
--     suppliers, each with their own SKU, pack size, and product name
--   • is_preferred flags the default supplier per item
--     (owner can override via dropdown on the restock page)
--
-- All quantities seeded at 0. Run a stocktake after launch to fill in
-- current_quantity, low_stock_threshold, and unit_of_measure.
-- Supplier mappings deferred pending data collection from owner.
-- ============================================================

-- Optional: create and use database
-- CREATE DATABASE freshcount_db;
-- USE freshcount_db;

-- ============================================================
-- Drop tables if re-running script
-- Order matters: drop children before parents
-- ============================================================

DROP TABLE IF EXISTS stock_movements;
DROP TABLE IF EXISTS supplier_items;
DROP TABLE IF EXISTS stock_items;
DROP TABLE IF EXISTS stocktake_sessions;
DROP TABLE IF EXISTS users;
DROP TABLE IF EXISTS suppliers;
DROP TABLE IF EXISTS categories;

-- ============================================================
-- Categories
-- ============================================================

CREATE TABLE categories (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ============================================================
-- Suppliers
-- ============================================================

CREATE TABLE suppliers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    phone VARCHAR(30),
    email VARCHAR(100),
    website VARCHAR(255),
    notes VARCHAR(255),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ============================================================
-- Stock Items
-- Note: no supplier_id column. Supplier links live in supplier_items.
-- ============================================================

CREATE TABLE stock_items (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    category_id INT NOT NULL,
    current_quantity DECIMAL(10,2) NOT NULL DEFAULT 0,
    low_stock_threshold DECIMAL(10,2) DEFAULT NULL,
    unit_of_measure VARCHAR(20) DEFAULT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_stock_items_category
        FOREIGN KEY (category_id) REFERENCES categories(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE,

    CONSTRAINT uq_stock_item_name_category
        UNIQUE (name, category_id)
) ENGINE=InnoDB;

-- ============================================================
-- Supplier Items (join table)
-- One stock item can be supplied by multiple suppliers.
-- Each pairing carries its own SKU, pack size, and (optionally) the
-- name the supplier uses on their site/invoice.
-- ============================================================

CREATE TABLE supplier_items (
    id INT AUTO_INCREMENT PRIMARY KEY,
    stock_item_id INT NOT NULL,
    supplier_id INT NOT NULL,
    supplier_sku VARCHAR(80) NOT NULL,
    supplier_product_name VARCHAR(200),
    pack_size VARCHAR(50),
    is_preferred BOOLEAN NOT NULL DEFAULT FALSE,
    notes VARCHAR(255),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_supplier_items_item
        FOREIGN KEY (stock_item_id) REFERENCES stock_items(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT fk_supplier_items_supplier
        FOREIGN KEY (supplier_id) REFERENCES suppliers(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    -- Same item can't be linked to the same supplier twice
    CONSTRAINT uq_item_supplier UNIQUE (stock_item_id, supplier_id)
) ENGINE=InnoDB;

-- ============================================================
-- Stock Movements
-- Records every stock change: delivery, usage, waste, adjustment, initial
-- ============================================================

CREATE TABLE stock_movements (
    id INT AUTO_INCREMENT PRIMARY KEY,
    stock_item_id INT NOT NULL,
    change_qty DECIMAL(10,2) NOT NULL,
    movement_type ENUM('delivery','usage','waste','adjustment','initial') NOT NULL,
    occurred_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    note VARCHAR(255),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_stock_movements_item
        FOREIGN KEY (stock_item_id) REFERENCES stock_items(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- ============================================================
-- Optional Future Table: Users
-- Useful later if you add staff login or manager login
-- ============================================================

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role ENUM('manager','staff') NOT NULL DEFAULT 'staff',
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ============================================================
-- Optional Future Table: Stocktake Sessions
-- Useful later for weekly stocktakes
-- ============================================================

CREATE TABLE stocktake_sessions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    stocktake_date DATE NOT NULL,
    note VARCHAR(255),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- ============================================================
-- Indexes
-- ============================================================

CREATE INDEX idx_stock_items_name           ON stock_items(name);
CREATE INDEX idx_stock_items_category       ON stock_items(category_id);
CREATE INDEX idx_supplier_items_item        ON supplier_items(stock_item_id);
CREATE INDEX idx_supplier_items_supplier    ON supplier_items(supplier_id);
CREATE INDEX idx_supplier_items_sku         ON supplier_items(supplier_sku);
CREATE INDEX idx_supplier_items_preferred   ON supplier_items(is_preferred);
CREATE INDEX idx_stock_movements_item       ON stock_movements(stock_item_id);
CREATE INDEX idx_stock_movements_date       ON stock_movements(occurred_at);
CREATE INDEX idx_stock_movements_type       ON stock_movements(movement_type);

